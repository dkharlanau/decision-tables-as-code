{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dkharlanau.github.io/decision-tables-as-code/schema/decision-package.schema.json",
  "title": "Decision Tables as Code package v1",
  "type": "object",
  "required": ["version", "id", "tables"],
  "properties": {
    "version": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "metadata": {"type": "object"},
    "tables": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/table"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "table": {
      "type": "object",
      "required": ["id", "version", "path"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"const": 1},
        "path": {"type": "string", "minLength": 1},
        "depends_on": {
          "type": "array",
          "items": {"$ref": "#/$defs/dependency"}
        }
      },
      "additionalProperties": false
    },
    "dependency": {
      "type": "object",
      "required": ["table"],
      "properties": {
        "table": {"type": "string", "minLength": 1},
        "bind": {
          "type": "object",
          "additionalProperties": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    }
  }
}
