{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dkharlanau.github.io/decision-tables-as-code/schema/policy-pack.schema.json",
  "title": "Decision Tables as Code policy pack v1",
  "type": "object",
  "required": ["version", "id", "rules"],
  "properties": {
    "version": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "severity": {"enum": ["error", "warning"], "default": "error"},
    "rules": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "required_rule_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["owner", "source", "ticket", "rationale"]}
        },
        "allowed_hit_policies": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["unique", "first", "collect"]}
        },
        "allowed_operators": {
          "$ref": "#/$defs/operators"
        },
        "forbidden_operators": {
          "$ref": "#/$defs/operators"
        },
        "require_input_domains": {"type": "boolean"},
        "max_rules": {"type": "integer", "minimum": 1},
        "require_complete_effective_window": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "operators": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "eq",
          "ne",
          "in",
          "not_in",
          "gt",
          "gte",
          "lt",
          "lte",
          "between",
          "exists",
          "regex",
          "present"
        ]
      }
    }
  }
}
