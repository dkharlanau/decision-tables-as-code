{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dkharlanau.github.io/decision-tables-as-code/schema/decision-table.schema.json",
  "title": "Decision Tables as Code v1",
  "type": "object",
  "required": ["version", "id", "inputs", "outputs", "rules"],
  "properties": {
    "version": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "name": {"type": "string"},
    "description": {"type": "string"},
    "hit_policy": {"enum": ["unique", "first", "collect"]},
    "metadata": {"type": "object"},
    "inputs": {
      "type": "array",
      "items": {"$ref": "#/$defs/input"}
    },
    "outputs": {
      "type": "array",
      "items": {"$ref": "#/$defs/output"}
    },
    "rules": {
      "type": "array",
      "items": {"$ref": "#/$defs/rule"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "input": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "type": {"enum": ["string", "integer", "number", "boolean", "date", "any"]},
        "description": {"type": "string"},
        "domain": {"type": "array"}
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "type": {"enum": ["string", "integer", "number", "boolean", "date", "any"]},
        "description": {"type": "string"}
      },
      "additionalProperties": false
    },
    "rule": {
      "type": "object",
      "required": ["id", "when", "then"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "priority": {"type": "integer"},
        "when": {"type": "object"},
        "then": {"type": "object"}
      },
      "additionalProperties": false
    }
  }
}
